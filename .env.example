# AI provider: "gemini" (default, free tier) or "openai"
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when AI_PROVIDER=openai — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Supabase cloud sync (app works fully offline without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
